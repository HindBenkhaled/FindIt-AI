# Local runtime data. SQLite, uploads, and embedding caches are created here.
FINDIT_DATA_DIR=data

# Current candidates selected on development benchmarks.
FINDIT_TEXT_MODEL=intfloat/e5-base-v2
FINDIT_IMAGE_MODEL=google/siglip-base-patch16-224
FINDIT_DEVICE=cpu

# Local demo access only; replace this value before starting the API.
FINDIT_STAFF_KEY=replace-with-a-long-random-local-key
